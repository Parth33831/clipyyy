{
  "name": "clipyyy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build frontend --config frontend/vite.config.ts && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "lucide-react": "^1.67.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
