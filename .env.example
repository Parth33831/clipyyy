CLIPYYY_S3_BUCKET=
CLIPYYY_S3_ACCESS_KEY_ID=
CLIPYYY_S3_SECRET_ACCESS_KEY=
CLIPYYY_S3_PUBLIC_BASE_URL=

# Downloads & storage (optional)
CLIPYYY_COOKIES_FROM_BROWSER=
CLIPYYY_COOKIES_FILE=
CLIPYYY_HOME=
